<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_limited_contacts" model="ir.ui.view">
        <field name="name">res.users.form.limited.contacts</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Insertar de forma robusta dentro de la pestaña Access Rights -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Filtrado" invisible="not id">
                    <field name="limited_contacts_salesperson"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
