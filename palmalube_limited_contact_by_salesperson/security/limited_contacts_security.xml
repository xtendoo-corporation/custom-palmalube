<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Sistema de restricción de contactos para comerciales (Palmalube) - Odoo 18

            FUNCIONAMIENTO:
            - Solo se crea UNA regla para res.partner
            - Odoo ya permite a los usuarios leer su propio registro de res.users por defecto
            - Los comerciales con este grupo solo ven contactos donde ellos son el comercial

            PATRÓN USADO POR ODOO:
            Similar a sale/security/ir_rules.xml línea 50:
            <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
        -->

        <!-- Grupo para identificar comerciales con restricción -->
        <record id="group_palmalube_limited_contacts_salesperson" model="res.groups">
            <field name="name">Palmalube: Comerciales con contactos limitados</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
            <field name="comment">Los usuarios de este grupo solo verán contactos donde ellos sean el comercial asignado (campo user_id)</field>
        </record>

        <!-- REGLA: Solo contactos propios (o sin comercial asignado) -->
        <record id="rule_palmalube_partner_limited_salesperson" model="ir.rule">
            <field name="name">Palmalube: Comerciales Limitados - Solo contactos propios</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|',('user_id','=',user.id),('partner_share','=',False)]</field>
            <field name="groups" eval="[(4, ref('group_palmalube_limited_contacts_salesperson'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
