<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_order_form_inherit_equipment" model="ir.ui.view">
        <field name="name">fsm.order.form.inherit.equipment</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="xtendoo_fsm.view_xtendoo_fsm_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="before">
                <field name="equipment_ids" widget="many2many_tags" options="{'no_create': True}" />
                <field name="equipment_count" invisible="1" />
            </xpath>

            <xpath expr="//field[@name='location_id']" position="after">
                <field name="partner_city" />
            </xpath>

            <xpath expr="//field[@name='partner_city']" position="after">
                <field name="is_recurring" />
                <field name="recurring_period" invisible="not is_recurring" required="is_recurring" />
                <field name="recurring_quantity" invisible="not is_recurring" required="is_recurring" />
                <field name="next_maintenance_date" invisible="not is_recurring" readonly="1" />
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Equipos y Checklists" name="equipment_lines">
                    <field name="equipment_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="equipment_id" options="{'no_create': True}" />
                            <field name="equipment_partner_id" />
                            <field name="survey_id" />
                            <field name="survey_state" widget="badge"
                                decoration-success="survey_state == 'completed'"
                                decoration-warning="survey_state == 'in_progress'"
                                decoration-danger="survey_state == 'not_started'" />
                            <button name="action_start_survey" type="object"
                                title="Iniciar Checklist"
                                icon="fa-play-circle"
                                invisible="not survey_id or survey_state == 'completed'" />
                            <button name="action_view_survey_result" type="object"
                                title="Ver Resultados"
                                icon="fa-bar-chart"
                                invisible="survey_state != 'completed'" />
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//button[@name='action_create_repair']" position="replace" />
            <xpath expr="//button[@name='action_create_sale_order']" position="replace">
                <button name="action_create_sale_order" string="Crear Orden de Venta"
                    type="object" class="btn-secondary"
                    invisible="sale_order_ids" />
                <button name="action_open_sale_order" string="Ver Orden de Venta"
                    type="object" class="btn-primary"
                    invisible="not sale_order_ids" />
            </xpath>

            <xpath expr="//field[@name='date_scheduled']" position="replace">
                <field name="date_open" readonly="1" />
            </xpath>

            <xpath expr="//field[@name='description']" position="after">
                <field name="amount_total" string="Importe de la venta"></field>
            </xpath>
        </field>
    </record>

    <!-- Vista Lista heredada para órdenes FSM -->
    <record id="view_xtendoo_fsm_order_tree_inherit" model="ir.ui.view">
        <field name="name">fsm.order.tree.inherit.palmalube</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="xtendoo_fsm.view_xtendoo_fsm_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Órdenes de Trabajo">
                    <field name="name" />
                    <field name="description" />
                    <field name="partner_city" />
                    <field name="date_open" />
                    <field name="responsible_id" />
                    <field name="partner_id" />
                    <field name="person_ids" widget="many2many_tags" />
                    <field name="date_start" />
                    <field name="amount_total" sum="Total" />
                    <field name="priority_level" widget="priority" />
                </list>
            </xpath>
        </field>
    </record>

    <!-- Modificar acción para quitar vista kanban -->
    <record id="xtendoo_fsm.action_xtendoo_fsm_order" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="context">{'order': 'name desc'}</field>
    </record>
</odoo>
