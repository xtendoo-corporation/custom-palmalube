<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_contact_address_import_wizard" model="ir.ui.view">
        <field name="name">partner.contact.address.import.wizard.form</field>
        <field name="model">partner.contact.address.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar direcciones y contactos vinculados">
                <group>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_contact_address_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar direcciones y contactos vinculados</field>
        <field name="res_model">partner.contact.address.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

