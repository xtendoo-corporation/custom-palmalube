<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar el reporte de venta -->
    <template id="report_saleorder_document_inherit_equipo_intervencion" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <t t-if="doc.tiene_equipos_o_intervencion">
                <th name="equipo_ids" class="text-start">Equipos</th>
                <th name="intervencion" class="text-start">Intervención</th>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="after">
            <t t-if="doc.tiene_equipos_o_intervencion">
                <td name="td_equipo_ids">
                    <t t-foreach="line.equipo_ids" t-as="equipment">
                        <span t-field="equipment.name"/>
                        <br/>
                    </t>
                </td>
                <td name="td_intervencion">
                    <span t-field="line.intervencion"/>
                </td>
            </t>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id.name']" position="after">
            <div class="col">
                <strong>Modo de pago:</strong>
                <br/>
                <span t-if="doc.payment_mode_id" t-field="doc.payment_mode_id.name"/>
            </div>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom']" position="replace">
        </xpath>
    </template>
</odoo>
