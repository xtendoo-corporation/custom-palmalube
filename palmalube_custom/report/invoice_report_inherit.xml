<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar el reporte de factura -->
    <template id="report_invoice_document_inherit_equipo_intervencion" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <t t-if="o.tiene_equipos_o_intervencion">
                <th name="equipo_ids" class="text-start">Equipos</th>
                <th name="intervencion" class="text-start">Intervención</th>
            </t>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <t t-if="o.tiene_equipos_o_intervencion">
                <td name="td_equipo_ids">
                    <t t-foreach="line.equipo_ids" t-as="equipment">
                        <span t-field="equipment.name"/>
                        <br/>
                    </t>
                </td>
                <td name="td_intervencion">
                    <span t-field="line.intervencion"/>
                </td>
            </t>
        </xpath>
        <xpath expr="//div[@name='reference']" position="after">
            <div class="col">
                <strong>Modo de pago:</strong>
                <br/>
                <span t-if="o.payment_mode_id" t-field="o.payment_mode_id.name"/>
            </div>
        </xpath>

        <xpath expr="//td[@name='td_quantity']" position="replace">
            <td name="td_quantity" class="o_td_quantity text-end">
                <span t-field="line.quantity" class="text-nowrap">3.00</span>
            </td>
        </xpath>
    </template>
</odoo>
