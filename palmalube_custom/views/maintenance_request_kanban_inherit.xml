<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredar la vista kanban de solicitudes de mantenimiento -->
        <record id="inherit_hr_equipment_request_view_kanban" model="ir.ui.view">
            <field name="name">
                maintenance.hr_equipment_request_view_kanban.inherit.customer.equipment</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban" />
            <field name="arch" type="xml">

                <!-- Ensure fields are available in the record object -->
                <xpath expr="//field[@name='archive']" position="after">
                    <field name="partner_id" />
                    <field name="employee_id" />
                    <field name="employee_ids" />
                </xpath>

                <!--
                    The original view has:
                    <span t-if="record.equipment_id.raw_value"><field name="equipment_id"/><span
                t-if="record.category_id.raw_value"> (<field name="category_id"/>)</span></span>
                    We replace the whole span to avoid using equipment_id in the t-if if it's not needed.
                -->
                <xpath expr="//span[field[@name='equipment_id']]" position="replace">

                </xpath>

                <xpath expr="//field[@name='name']" position="replace">
                    <field name="name" class="fw-bold fs-5" />
                </xpath>

                <!--
                    The hr_maintenance module replaces span[@name='owner_user_id'] with field[@name='employee_id'].
                    We target both just in case, or to be safe with the inheritance.
                -->
                <xpath
                    expr="//span[@name='owner_user_id'] | //t[@t-name='card']//field[@name='employee_id']"
                    position="replace">
                    <div class="d-flex flex-column">
                         <span t-if="record.partner_id.raw_value">
                            <strong>Cliente: </strong>
                            <field name="partner_id" />
                        </span>
                        <span t-if="record.employee_id.raw_value">
                            <strong>Creado por: </strong>
                            <field name="employee_id" />
                        </span>
                        <span t-if="record.employee_ids.raw_value">
                            <strong>Asignado a: </strong>
                            <field name="employee_ids" widget="many2many_tags" />
                        </span>
                    </div>
                </xpath>

                <!-- Remove the extra div added by maintenance_request_employee -->
                <xpath expr="//div[field[@name='employee_ids'][@widget='many2many_avatar_user']]"
                    position="replace" />

                <xpath expr="//field[@name='schedule_date']" position="replace">
                    <span t-if="record.schedule_date.raw_value">
                        <strong>Fecha Programada: </strong>
                        <field name="schedule_date" />
                    </span>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
