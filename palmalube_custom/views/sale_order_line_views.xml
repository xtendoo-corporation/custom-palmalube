<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredamos la vista de formulario de pedido de venta para mostrar columnas en las líneas del pedido -->
    <record id="view_order_form_inherit_equipo_intervencion" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.equipos.intervencion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="equipo_ids" widget="many2many_tags"/>
                <field name="intervencion"/>
            </xpath>
        </field>
    </record>
</odoo>
