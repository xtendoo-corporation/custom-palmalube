<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_comercial_see_own" model="ir.rule">
        <field name="name">Ver solo pagos donde soy comercial</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="domain_force">['|',('comercial_id','=',user.id),('comercial_id','=',False)]</field>
        <field name="groups"
            eval="[(4, ref('palmalube_limited_contact_by_salesperson.group_palmalube_limited_contacts_salesperson'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>