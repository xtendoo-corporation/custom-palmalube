<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_equipment_images_wizard_form" model="ir.ui.view">
        <field name="name">import.equipment.images.wizard.form</field>
        <field name="model">import.equipment.images.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar imágenes de equipos">
                <group>
                    <field name="master_xml_file" filename="master_xml_filename"/>
                    <field name="images_file" filename="images_file_filename"/>
                    <field name="images_file_type"/>
                    <field name="images_zip_file" filename="images_zip_filename"/>
                </group>
                <footer>
                    <button name="action_import_images" type="object" string="Importar imágenes" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
                <group>
                    <field name="log" nolabel="1" readonly="1" widget="text"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_import_equipment_images_wizard" model="ir.actions.act_window">
        <field name="name">Importar imágenes de equipos</field>
        <field name="res_model">import.equipment.images.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_equipment_images_root" name="Importar imágenes de equipos" parent="maintenance.menu_equipment_form" action="action_import_equipment_images_wizard" sequence="100"/>
</odoo>
