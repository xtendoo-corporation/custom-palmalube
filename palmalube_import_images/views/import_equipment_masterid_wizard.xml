<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_equipment_masterid_wizard_form" model="ir.ui.view">
        <field name="name">import.equipment.masterid.wizard.form</field>
        <field name="model">import.equipment.masterid.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar y asignar ID externo a equipos">
                <group>
                    <field name="master_xml_file" filename="master_xml_filename"/>
                </group>
                <footer>
                    <button name="action_import_master_ids" type="object" string="Importar y asignar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
                <group>
                    <field name="log" nolabel="1" readonly="1" widget="text"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_import_equipment_masterid_wizard" model="ir.actions.act_window">
        <field name="name">Importar y asignar ID externo a equipos</field>
        <field name="res_model">import.equipment.masterid.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_equipment_masterid_root" name="Importar y asignar ID externo a equipos" parent="maintenance.menu_equipment_form" action="action_import_equipment_masterid_wizard" sequence="110"/>
</odoo>

