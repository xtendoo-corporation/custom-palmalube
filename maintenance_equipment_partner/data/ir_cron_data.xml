<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Acción programada para enviar recordatorios de mantenimiento -->
        <record id="ir_cron_maintenance_reminder" model="ir.cron">
            <field name="name">Mantenimiento: Enviar recordatorios 15 días antes</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_maintenance_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

