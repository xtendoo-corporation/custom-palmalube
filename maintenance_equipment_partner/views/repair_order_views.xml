<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_inherit_set_to_draft" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.set.to.draft</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_set_to_draft" type="object" string="Volver a borrador"
                        modifiers='{"invisible": [["state", "=", "draft"]]}'
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
