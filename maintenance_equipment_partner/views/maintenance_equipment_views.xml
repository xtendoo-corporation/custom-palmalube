<odoo>

    <record id="maintenance_equipment_view_form_partner" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.partner</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <!-- Añadir campos después de category_id y luego ocultar category_id -->
            <xpath expr="//div[@class='oe_title']" position="replace">
                 <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>
                <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="customer_id"/>
                <field name="maintenance_price"/>
            </xpath>

            <!-- Ocultar campo category_id -->
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='model']" position="before">
                <field name="equipment_brand"/>
                <field name="id_equipment"/>
            </xpath>
            <xpath expr="//field[@name='cost']" position="before">
                <field name="year_manufacture"/>
            </xpath>
            <xpath expr="//page[@name='maintenance']" position="after">
                <page string="Imágenes adicionales">
                    <field name="images_ids" nolabel="1">
                        <kanban>
                            <templates>
                                <t t-name="kanban-box">
                                    <div style="width: 360px; margin: 4px; text-align: center;">
                                        <field name="image" widget="image" options="{'size': [192, 192]}"/>
                                        <div>
                                            <field name="name"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Imagen adicional">
                            <sheet>
                                <group>
                                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                                    <field name="name"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_view_search_partner" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.partner</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="customer_id"/>
                <field name="equipment_brand"/>
                <field name="year_manufacture"/>
            </field>
            <group position="inside">
                <filter
                    name="groupby_customer"
                    string="Cliente"
                    context="{'group_by': 'customer_id'}"
                />
                <filter
                    name="groupby_partner"
                    string="Proveedor"
                    context="{'group_by': 'partner_id'}"
                />
            </group>
        </field>
    </record>

    <record id="maintenance_equipment_view_tree_partner" model="ir.ui.view">
        <field name="name">maintenance.equipment.tree.partner</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="customer_id" optional="show"/>
                <field name="equipment_brand" optional="show"/>
                <field name="year_manufacture" optional="hide"/>
                <field name="maintenance_price" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
