<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main template for survey user input table report -->
        <template id="report_survey_user_input_table">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Header -->
                            <div class="row">
                                <div class="col-12">
                                    <h2>
                                        <span t-field="o.survey_id.title"/>
                                    </h2>
                                </div>
                            </div>

                            <!-- Survey Information -->
                            <div class="row mt-3 mb-3">
                                <div class="col-6">
                                    <strong>Técnico:</strong>
                                    <span t-if="o.fsm_order_id and o.fsm_order_id.person_ids">
                                        <t t-foreach="o.fsm_order_id.person_ids" t-as="person">
                                            <span t-field="person.name"/>
                                            <t t-if="not person_last">, </t>
                                        </t>
                                    </span>
                                    <span t-elif="o.partner_id" t-field="o.partner_id.name"/>
                                    <span t-else="" t-field="o.email"/>
                                    <br/>
                                    <strong>Equipo:</strong>
                                    <span t-if="o.fsm_order_id and o.fsm_order_id.equipment_ids">
                                        <t t-foreach="o.fsm_order_id.equipment_ids" t-as="equipment">
                                            <span t-field="equipment.name"/>
                                            <t t-if="not equipment_last">, </t>
                                        </t>
                                    </span>
                                    <span t-else="">No disponible</span>
                                </div>
                                <div class="col-6">
                                    <strong>Fecha:</strong>
                                    <span t-field="o.create_date" t-options='{"widget": "datetime"}'/>
                                </div>
                            </div>

                            <div class="row mb-3" t-if="o.survey_id.description">
                                <div class="col-12">
                                    <strong>Descripción:</strong>
                                    <div t-field="o.survey_id.description"/>
                                </div>
                            </div>

                            <!-- Responses Table -->
                            <div class="row">
                                <div class="col-12">
                                    <h4>Respuestas</h4>
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 40%;">Pregunta</th>
                                                <th class="text-center" style="width: 20%;">BIEN</th>
                                                <th class="text-center" style="width: 20%;">MAL</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t
                                                t-foreach="o.user_input_line_ids.sorted(key=lambda l: (l.question_sequence, l.id))"
                                                t-as="line">
                                                <tr class="align-middle" style="height: 2.5em;">
                                                    <td>
                                                        <strong t-field="line.question_id.title"/>
                                                        <div t-if="line.question_id.description"
                                                             class="text-muted small">
                                                            <span
                                                                t-field="line.question_id.description"/>
                                                        </div>
                                                    </td>
                                                    <!-- Mostrar los checkbox solo si el tipo de
                                                    pregunta es 'Opción múltiple: solo una
                                                    respuesta' -->


                                                    <td class="text-center">
                                                        <t t-if="line.display_name == 'SI'">
                                                            <i class="fa fa-check text-success"/>
                                                        </t>
                                                        <t
                                                            t-if="line.display_name not in ['SI', 'NO']">
                                                            <span t-field="line.display_name"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-if="line.display_name == 'NO'">
                                                            <i class="fa fa-times text-danger"/>
                                                        </t>
                                                        <t
                                                            t-if="line.display_name not in ['SI', 'NO']">
                                                            <span t-field="line.display_name"/>
                                                        </t>
                                                    </td>

                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Score information if applicable -->
                            <div class="row mt-3"
                                 t-if="o.scoring_total and o.survey_id.scoring_type != 'no_scoring'">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <strong>Puntuación:</strong>
                                        <span t-field="o.scoring_total"/>
                                        /
                                        <span t-esc="o.scoring_total_max or 0"/>
                                        <t
                                            t-if="o.scoring_percentage">(<span
                                            t-esc="'%.2f' % o.scoring_percentage"/>%)
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <div t-if="o.observations" style="page-break-inside: avoid;">
                                <strong>Observaciones:</strong>
                                <div t-field="o.observations"/>
                            </div>
                            <br/>
                            <div class="row" style="page-break-inside: avoid;">
                                <div class="col-6" t-if="o.next_maintenance_date">
                                    <strong>Fecha próxima revisión:</strong>
                                    <span t-field="o.next_maintenance_date"
                                          t-options='{"widget": "date"}'/>
                                </div>
                                <div class="col-6" t-if="o.fsm_order_amount_total">
                                    <strong>Importe:</strong>
                                    <span t-field="o.fsm_order_amount_total"/>
                                </div>
                            </div>
                            <br/>
                            <div class="row" style="page-break-inside: avoid;">
                                <div class="col-6" t-if="o.signature">
                                    <strong>Firma del técnico:</strong>
                                    <br/>
                                    <img t-att-src="image_data_uri(o.signature)"
                                         style="max-height: 4cm; max-width: 8cm;"/>
                                    <br/>
                                    <span t-field="o.fsm_order_id.person_ids"/>
                                </div>
                                <div class="col-6" t-if="o.signature_client">
                                    <strong>Firma del cliente:</strong>
                                    <br/>
                                    <img t-att-src="image_data_uri(o.signature_client)"
                                         style="max-height: 4cm; max-width: 8cm;"/>
                                    <br/>
                                    <span t-field="o.fsm_order_id.partner_id"/>
                                </div>
                            </div>
                            <br/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
