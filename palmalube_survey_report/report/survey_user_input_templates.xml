<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main template for survey user input table report -->
        <template id="report_survey_user_input_table">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Header -->
                            <div class="row">
                                <div class="col-12">
                                    <h2>
                                        <span t-field="o.survey_id.title" />
                                    </h2>
                                </div>
                            </div>

                            <!-- Survey Information -->
                            <div class="row mt-3 mb-3">
                                <div class="col-6">
                                    <strong>Técnico:</strong>
                                    <span t-if="o.fsm_order_id and o.fsm_order_id.person_ids">
                                        <t t-foreach="o.fsm_order_id.person_ids" t-as="person">
                                            <span t-field="person.name" />
                                            <t t-if="not person_last">,</t>
                                        </t>
                                    </span>
                                    <span t-elif="o.partner_id" t-field="o.partner_id.name" />
                                    <span t-else="" t-field="o.email" />
                                </div>
                                <div class="col-6">
                                    <strong>Fecha:</strong>
                                    <span t-field="o.create_date" t-options='{"widget": "datetime"}' />
                                </div>
                            </div>

                            <!-- Customer Information -->
                            <div class="row mb-3"
                                t-if="o.fsm_order_id and o.fsm_order_id.partner_id">
                                <div class="col-6">
                                    <strong>Cliente:</strong>
                                    <span t-field="o.fsm_order_id.partner_id.name" />
                                    <br />
                                    <t t-if="o.fsm_order_id.partner_id.vat">
                                        <span t-field="o.fsm_order_id.partner_id.vat" />
                                        <br />
                                    </t>
                                    <t t-if="o.fsm_order_id.partner_id.street">
                                        <span t-field="o.fsm_order_id.partner_id.street" />
                                        <span t-if="o.fsm_order_id.partner_id.street2">, <span
                                                t-field="o.fsm_order_id.partner_id.street2" />
                                        </span>
                                        <br
                                            t-if="o.fsm_order_id.partner_id.city or o.fsm_order_id.partner_id.zip" />
                                        <span t-if="o.fsm_order_id.partner_id.zip">
                                            <span t-field="o.fsm_order_id.partner_id.zip" />
                                        </span>
                                        <span t-if="o.fsm_order_id.partner_id.city">
                                            <span t-field="o.fsm_order_id.partner_id.city" />
                                        </span>
                                        <span t-if="o.fsm_order_id.partner_id.state_id">, <span
                                                t-field="o.fsm_order_id.partner_id.state_id.name" />
                                        </span>
                                    </t>
                                    <br t-if="o.fsm_order_id.partner_id.country_id" />
                                    <span t-if="o.fsm_order_id.partner_id.country_id">
                                        <span t-field="o.fsm_order_id.partner_id.country_id.name" />
                                    </span>
                                    <br />
                                    <t t-if="o.fsm_order_id.partner_id.phone">
                                        <span t-field="o.fsm_order_id.partner_id.phone" />
                                        <span t-if="o.fsm_order_id.partner_id.mobile">
                                            <br />
                                            <span t-field="o.fsm_order_id.partner_id.mobile" />
                                        </span>
                                    </t>
                                </div>
                                <div class="col-6">
                                    <strong>Fecha próxima revisión:</strong>
                                    <span t-field="o.next_maintenance_date"
                                        t-options='{"widget": "date"}' />
                                    <!--                                    <br/>-->
                                    <!--                                    <strong>Importe:</strong>-->
                                    <!--                                    <span t-field="o.fsm_order_amount_total"/>-->
                                </div>
                            </div>

                            <!-- Equipment Table -->
                            <div class="row mb-3"
                                t-if="o.fsm_order_equipment_line_id and o.fsm_order_equipment_line_id.equipment_id">
                                <div class="col-12">
                                    <h4>Equipo</h4>
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 40%;">
                                                    Descripción
                                                </th>
                                                <th class="text-left" style="width: 15%;">Nº Serie</th>
                                                <th class="text-left" style="width: 15%;">Marca</th>
                                                <th class="text-left" style="width: 15%;">Modelo</th>
                                                <th class="text-left" style="width: 15%;">Año de
                                                    Fabricación</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="equipment"
                                                t-value="o.fsm_order_equipment_line_id.equipment_id" />
                                            <tr>
                                                <td>
                                                    <span t-field="equipment.name" />
                                                </td>
                                                <td>
                                                    <span t-field="equipment.serial_no" />

                                                </td>
                                                <td>
                                                    <span t-field="equipment.equipment_brand" />
                                                </td>
                                                <td>
                                                    <span t-field="equipment.model" />
                                                </td>
                                                <td>
                                                    <span t-field="equipment.year_manufacture" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="row mb-3" t-if="o.survey_id.description">
                                <div class="col-12">
                                    <strong>Descripción:</strong>
                                    <div t-field="o.survey_id.description" />
                                </div>
                            </div>

                            <!-- Responses Table -->
                            <div class="row">
                                <div class="col-12">
                                    <h4>Respuestas</h4>
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 40%;">Pregunta</th>
                                                <th class="text-center" style="width: 20%;">BIEN</th>
                                                <th class="text-center" style="width: 20%;">MAL</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t
                                                t-foreach="o.user_input_line_ids.sorted(key=lambda l: (l.question_sequence, l.id))"
                                                t-as="line">
                                                <tr class="align-middle" style="height: 2.5em;">
                                                    <td>
                                                        <strong t-field="line.question_id.title" />
                                                        <div t-if="line.question_id.description"
                                                            class="text-muted small">
                                                            <span
                                                                t-field="line.question_id.description" />
                                                        </div>
                                                    </td>
                                                    <!-- Mostrar los checkbox solo si el tipo de
                                                    pregunta es 'Opción múltiple: solo una
                                                    respuesta' -->


                                                    <td class="text-center">
                                                        <t
                                                            t-if="line.display_name in ['SI', 'BIEN', 'OPERATIVO']">
                                                            <t t-if="line.display_name == 'BIEN'">
                                                                <i class="fa fa-check text-success" />
                                                            </t>
                                                            <t t-else="">
                                                                <span t-field="line.display_name" />
                                                            </t>
                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <t
                                                            t-if="line.display_name in ['NO', 'MAL', 'NO OPERATIVO']">
                                                            <t t-if="line.display_name == 'MAL'">
                                                                <i class="fa fa-times text-danger" />
                                                            </t>
                                                            <t t-else="">
                                                                <span t-field="line.display_name" />
                                                            </t>
                                                        </t>
                                                    </td>

                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Score information if applicable -->
                            <div class="row mt-3"
                                t-if="o.scoring_total and o.survey_id.scoring_type != 'no_scoring'">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <strong>Puntuación:</strong>
                                        <span t-field="o.scoring_total" />
                                        / <span t-esc="o.scoring_total_max or 0" />
                                        <t
                                            t-if="o.scoring_percentage">(<span
                                                t-esc="'%.2f' % o.scoring_percentage" />%) </t>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div t-if="o.observations" style="page-break-inside: avoid;">
                                <strong>Observaciones:</strong>
                                <div t-field="o.observations" />
                            </div>
                            <br />
                            <!--                            <div class="row" style="page-break-inside: avoid;">-->
                            <!--                                <div class="col-6" t-if="o.next_maintenance_date">-->
                            <!--                                    <strong>Fecha próxima revisión:</strong>-->
                            <!--                                    <span t-field="o.next_maintenance_date"-->
                            <!--                                          t-options='{"widget": "date"}'/>-->
                            <!--                                </div>-->
                            <!--                                <div class="col-6" t-if="o.fsm_order_amount_total">-->
                            <!--                                    <strong>Importe:</strong>-->
                            <!--                                    <span t-field="o.fsm_order_amount_total"/>-->
                            <!--                                </div>-->
                            <!--                            </div>-->
                            <br />
                            <div class="row" style="page-break-inside: avoid;">
                                <div class="col-6" t-if="o.signature">
                                    <strong>Firma del técnico:</strong>
                                    <br />
                                    <img t-att-src="image_data_uri(o.signature)"
                                        style="max-height: 4cm; max-width: 8cm;" />
                                    <br />
                                    <span t-field="o.fsm_order_id.person_ids" />
                                </div>
                                <div class="col-6" t-if="o.signature_client">
                                    <strong>Firma del cliente:</strong>
                                    <br />
                                    <img t-att-src="image_data_uri(o.signature_client)"
                                        style="max-height: 4cm; max-width: 8cm;" />
                                    <br />
                                    <span t-field="o.fsm_order_id.partner_id" />
                                </div>
                            </div>
                            <br />
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>