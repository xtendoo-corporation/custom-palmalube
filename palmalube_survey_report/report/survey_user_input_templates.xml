<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main template for survey user input table report -->
        <template id="report_survey_user_input_table">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <!-- Header -->
                            <div class="row">
                                <div class="col-12">
                                    <h2>
                                        <span t-field="o.survey_id.title"/>
                                    </h2>
                                </div>
                            </div>

                            <!-- Survey Information -->
                            <div class="row mt-3 mb-3">
                                <div class="col-6">
                                    <strong>Usuario:</strong>
                                    <span t-if="o.partner_id" t-field="o.partner_id.name"/>
                                    <span t-else="" t-field="o.email"/>
                                    <br/>
                                    <strong>Equipo:</strong>
                                    <span t-if="o.maintenance_request_id and o.maintenance_request_id.equipment_id">
                                        <span t-esc="o.maintenance_request_id.equipment_id.display_name"/>
                                    </span>
                                    <span t-else="">No disponible</span>
                                </div>
                                <div class="col-6">
                                    <strong>Fecha:</strong>
                                    <span t-field="o.create_date" t-options='{"widget": "datetime"}'/>
                                    <t t-if="o.date_next_revision">
                                    <br/>
                                        <strong>Fecha próxima revisión:</strong>
                                        <span t-field="o.date_next_revision" t-options='{"widget": "date"}'/>
                                    </t>
                                </div>
                            </div>

                            <div class="row mb-3" t-if="o.survey_id.description">
                                <div class="col-12">
                                    <strong>Descripción:</strong>
                                    <div t-field="o.survey_id.description"/>
                                </div>
                            </div>

                            <!-- Responses Table -->
                            <div class="row">
                                <div class="col-12">
                                    <h4>Respuestas</h4>
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 40%;">Pregunta</th>
                                                <th class="text-center" style="width: 20%;">BIEN</th>
                                                <th class="text-center" style="width: 20%;">MAL</th>
                                                <th class="text-center" style="width: 20%;">VALOR</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="o.user_input_line_ids.sorted(key=lambda l: (l.question_sequence, l.id))"
                                               t-as="line">
                                                <tr class="align-middle" style="height: 2.5em;">
                                                    <td>
                                                        <strong t-field="line.question_id.title"/>
                                                        <div t-if="line.question_id.description" class="text-muted small">
                                                            <span t-field="line.question_id.description"/>
                                                        </div>
                                                    </td>
                                                    <!-- Mostrar los checkbox solo si el tipo de pregunta es 'Opción múltiple: solo una respuesta' -->
                                                    <t t-if="line.question_id.question_type == 'simple_choice'">
                                                        <td class="text-center">
                                                            <input type="checkbox"
                                                                   t-att-checked="'checked' if line.display_name == 'BIEN' else None"
                                                                   disabled="disabled"/>
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="checkbox"
                                                                   t-att-checked="'checked' if line.display_name == 'MAL' else None"
                                                                   disabled="disabled"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td></td>
                                                        <td></td>
                                                    </t>
                                                    <!-- Mostrar VALOR solo si existe y no es BIEN/MAL/omitida -->
                                                    <td class="text-center">
                                                        <span t-if="line.display_name and line.display_name not in ['BIEN', 'MAL', 'Omitida']"
                                                              t-esc="line.display_name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Score information if applicable -->
                            <div class="row mt-3" t-if="o.scoring_total and o.survey_id.scoring_type != 'no_scoring'">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <strong>Puntuación:</strong>
                                        <span t-field="o.scoring_total"/>
                                        /
                                        <span t-esc="o.scoring_total_max or 0"/>
                                        <t t-if="o.scoring_percentage">
                                            (<span t-esc="'%.2f' % o.scoring_percentage"/>%)
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div t-if="o.signature">
                                <strong>Firma del técnico:</strong>
                                <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
