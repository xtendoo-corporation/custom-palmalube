<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Wizard Form -->
    <record id="view_import_invoice_wizard_form" model="ir.ui.view">
        <field name="name">import.invoice.wizard.form</field>
        <field name="model">import.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Facturas Palmalube">
                <sheet>
                    <group name="main_group">
                        <group name="file_group" string="Archivo CSV">
                            <field name="csv_file" filename="csv_filename" />
                            <field name="csv_filename" invisible="1" />
                        </group>

                        <group name="config_group" string="Configuración">
                            <field name="company_id" />
                            <field name="journal_id" />
                            <field name="expense_account_id" />
                            <field name="tax_account_id" />
                            <field name="payable_account_id" />
                        </group>

                        <group name="options_group" string="Opciones">
                            <field name="create_partners" />
                            <field name="dry_run" />
                        </group>

                        <group
                            name="results_group"
                            string="Resultados"
                            invisible="result_message == False"
                        >
                            <field name="result_message" nolabel="1" colspan="2" />
                            <field name="total_rows" />
                            <field name="created_count" />
                            <field name="skipped_count" />
                            <field name="error_count" />
                            <field
                                name="error_log"
                                invisible="error_log == False"
                                colspan="2"
                                widget="text"
                            />
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>Formato CSV:</strong><br />
                        Cabecera: move_type,name,invoice_date,partner_name,amount_untaxed,amount_tax,amount_total,state,currency_id<br />
                        <br />
                        <strong>Notas:</strong><br />
                        - El campo partner_name puede contener comas<br />
                        - Las facturas se crean como facturas de proveedor (in_invoice o in_refund)<br />
                        - Se valida que base + IVA = total con precisión al céntimo<br />
                        - Los duplicados se detectan por: ref + partner + fecha + tipo
                    </div>
                </sheet>

                <footer>
                    <button
                        name="action_import_invoices"
                        string="Importar"
                        type="object"
                        class="btn-primary"
                        invisible="result_message != False"
                    />
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_import_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Importación Palmalube</field>
        <field name="res_model">import.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move" />
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_palmalube_import_invoice"
        name="Importación Palmalube"
        parent="account.menu_finance_payables"
        action="action_import_invoice_wizard"
        sequence="100"
    />
</odoo>

