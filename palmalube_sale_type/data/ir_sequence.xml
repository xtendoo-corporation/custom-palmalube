<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia para Ventas (usando la estándar de ventas) -->
        <record id="seq_sale_order_ventas" model="ir.sequence">
            <field name="name">Ventas</field>
            <field name="code">sale.order.ventas</field>
            <field name="prefix">VTA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Secuencia para Reparaciones -->
        <record id="seq_sale_order_reparacion" model="ir.sequence">
            <field name="name">Reparacion</field>
            <field name="code">sale.order.reparacion</field>
            <field name="prefix">REP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
