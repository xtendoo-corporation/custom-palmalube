<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="survey_fill_form_done_inherit_results" inherit_id="survey.survey_fill_form_done" name="Survey: finished (custom results button)">
        <xpath expr="//div[@class='d-flex gap-3 mt-3']" position="after">
            <div class="d-flex gap-3 mt-3">
                <a role="button" class="btn btn-info btn-lg" t-att-href="'/web#id=%s&amp;model=survey.user_input&amp;view_type=form' % answer.id">
                    <i class="fa fa-table"/>
                    Ver ficha de resultados
                </a>
            </div>
        </xpath>
    </template>
</odoo>

