<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit maintenance equipment form view -->
    <record id="maintenance_equipment_view_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.survey</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">

            <field name="category_id" position="after">
                <field name="default_survey_id" options="{'no_create': True}"/>
            </field>

        </field>
    </record>

</odoo>

