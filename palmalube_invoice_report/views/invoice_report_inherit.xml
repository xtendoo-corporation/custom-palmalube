<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar el reporte de factura -->
    <template id="report_invoice_document_inherit_document_format"
        inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='due_date']" position="replace" />
        <xpath expr="//div[@name='delivery_date']" position="replace" />
        <xpath expr="//div[@name='customer_code']" position="replace" />
        <xpath expr="//div[@name='invoice_date']" position="attributes">
            <attribute name="class">col-2</attribute>
        </xpath>
        <xpath expr="//div[@name='invoice_date']" position="attributes">
            <attribute name="class">col-2</attribute>
        </xpath>
        <xpath expr="//div[@name='origin']" position="replace">
            <div class="col-6" t-if="o.invoice_origin" name="origin">
                <strong>Albarán</strong>
                <div t-field="o.invoice_origin">SO123</div>
            </div>
        </xpath>

        <xpath
            expr="//t[@t-if='o.sigaus_has_line and line.move_id.company_id.sigaus_enable and line.move_id.company_id.sigaus_show_in_reports and line.product_id and line.product_id.sigaus_has_amount']"
            position="replace" />

        <!-- Tabla de equipos antes de la tabla de líneas de factura -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-set="all_equipos" t-value="o.invoice_line_ids.mapped('equipo_ids')" />
            <t t-if="all_equipos">
                <h5>Equipos</h5>
                <table class="table table-sm o_main_table table-borderless mt-4"
                    style="margin-bottom: 2rem;">
                    <thead>
                        <tr>
                            <th class="text-start">Descripción</th>
                            <th class="text-start">Modelo</th>
                            <th class="text-start">Número de serie</th>
                            <th class="text-start">Año</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="all_equipos" t-as="equipment">
                            <td>
                                <span t-field="equipment.name" />
                            </td>
                            <td>
                                <span t-field="equipment.model" />
                            </td>
                            <td>
                                <span t-field="equipment.serial_no" />
                            </td>
                            <td>
                                <span t-field="equipment.year_manufacture" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>
</odoo>
